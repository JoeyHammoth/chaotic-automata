{
  "name": "computation-atlas-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run copy:products && npm run build:fixtures",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run copy:products && npm run build:fixtures",
    "copy:products": "node scripts/copy-products.mjs",
    "build:fixtures": "vite-node scripts/build-fixtures.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "lighthouse": "13.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
